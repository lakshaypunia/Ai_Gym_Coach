# Gemini coaching calls (app/api/feedback, app/api/plan) authenticate to
# Vertex AI via a GCP service account key, not a plain API key — see
# secrets.example.json. Place the real key at ./secrets.json (gitignored,
# never commit it).

# Optional: Vertex AI region. Defaults to us-central1 if unset.
GEMINI_LOCATION=us-central1
